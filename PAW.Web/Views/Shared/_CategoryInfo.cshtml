@model PAW.Models.DTO.CategoryDTO

<dl class="row mb-0">
    <dt class="col-sm-4">Category ID</dt>
    <dd class="col-sm-8">@Model.CategoryId</dd>

    <dt class="col-sm-4">Name</dt>
    <dd class="col-sm-8">@Model.CategoryName</dd>

    <dt class="col-sm-4">Description</dt>
    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Description) ? "Not available" : Model.Description)</dd>
</dl>
