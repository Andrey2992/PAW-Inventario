@model PAW.Web.Models.ProductDetailsViewModel

<h6 class="border-bottom pb-1">Product</h6>
<dl class="row">
    <dt class="col-sm-4">Product ID</dt>
    <dd class="col-sm-8">@Model.Product.ProductId</dd>

    <dt class="col-sm-4">Name</dt>
    <dd class="col-sm-8">@Model.Product.Name</dd>

    <dt class="col-sm-4">Description</dt>
    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Product.Description) ? "Not available" : Model.Product.Description)</dd>

    <dt class="col-sm-4">Rating</dt>
    <dd class="col-sm-8">@Model.Product.Rating / 5</dd>

    <dt class="col-sm-4">Created by</dt>
    <dd class="col-sm-8">@(Model.Product.CreatedBy ?? "Not available")</dd>

    <dt class="col-sm-4">Modified by</dt>
    <dd class="col-sm-8">@(Model.Product.ModifiedBy ?? "Not available")</dd>

    <dt class="col-sm-4">Last modified</dt>
    <dd class="col-sm-8">@Model.Product.ModifiedDate.ToString("yyyy-MM-dd HH:mm")</dd>
</dl>

@* Cada bloque asociado es una partial reutilizable por otras pantallas. *@
<h6 class="border-bottom pb-1">Inventory</h6>
@if (Model.Inventory is null)
{
    <p class="text-muted">No inventory assigned.</p>
}
else
{
    <partial name="~/Views/Inventory/_Details.cshtml" model="Model.Inventory" />
}

<h6 class="border-bottom pb-1 mt-3">Category</h6>
@if (Model.Category is null)
{
    <p class="text-muted">No category assigned.</p>
}
else
{
    <partial name="_CategoryInfo" model="Model.Category" />
}

<h6 class="border-bottom pb-1 mt-3">Supplier</h6>
@if (Model.Supplier is null)
{
    <p class="text-muted mb-0">No supplier assigned.</p>
}
else
{
    <partial name="_SupplierInfo" model="Model.Supplier" />
}
