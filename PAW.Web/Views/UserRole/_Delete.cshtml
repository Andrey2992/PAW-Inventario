@model PAW.Models.DTO.UserRoleDTO

<form asp-action="Delete" method="post" class="js-modal-form">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />

    @if (ViewData["ModalError"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <p>Are you sure you want to remove the role <strong>@(Model.RoleName ?? $"Role #{Model.RoleId}")</strong> from <strong>@(Model.UserName ?? $"User #{Model.UserId}")</strong>?</p>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
    </div>
</form>
