@model PAW.Models.DTO.NotificationDTO

<form asp-action="Delete" asp-route-id="" method="post" class="js-modal-form">
    @Html.AntiForgeryToken()
    <input asp-for="NotificationId" type="hidden" />

    @if (ViewData["ModalError"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <p>Are you sure you want to delete the notification <strong>#@Model.NotificationId</strong>?</p>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
    </div>
</form>
