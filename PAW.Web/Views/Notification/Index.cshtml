@model IEnumerable<PAW.Models.DTO.NotificationDTO>
@{
    ViewData["Title"] = "Notification Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Notifications</h2>

        <a asp-action="Create"
           class="btn btn-primary js-modal-link"
           data-modal-title="Add notification">
            <i class="bi bi-plus-circle"></i>
            Add Notification
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Notification ID</th>
                            <th>User ID</th>
                            <th>Message</th>
                            <th>Read</th>
                            <th>Created At</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var notification in Model)
                            {
                                <tr>

                                    <td>
                                        @notification.NotificationId
                                    </td>

                                    <td>
                                        @notification.UserId
                                    </td>

                                    <td>
                                        @notification.Message
                                    </td>

                                    <td>
                                        @if (notification.IsRead)
                                        {
                                            <span class="badge bg-success">Read</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Unread</span>
                                        }
                                    </td>

                                    <td>
                                        @(notification.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@notification.NotificationId"
                                               class="btn btn-sm btn-warning js-modal-link"
                                               data-modal-title="Edit notification">
                                                Edit
                                            </a>

                                            <!-- Details -->
                                            <a asp-action="Details"
                                               asp-route-id="@notification.NotificationId"
                                               class="btn btn-sm btn-info js-modal-link"
                                               data-modal-title="Notification details">
                                                Details
                                            </a>

                                            <!-- Delete -->
                                            <a asp-action="Delete"
                                               asp-route-id="@notification.NotificationId"
                                               class="btn btn-sm btn-danger js-modal-link"
                                               data-modal-title="Delete notification">
                                                Delete
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">
                                    No notifications found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

    <partial name="_Pagination" model='ViewData["Pagination"]' />

</div>
