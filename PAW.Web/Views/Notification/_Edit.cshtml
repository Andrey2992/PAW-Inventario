@model PAW.Models.DTO.NotificationDTO

<form asp-action="Edit" asp-route-id="" method="post" class="js-modal-form">
    @Html.AntiForgeryToken()
    <input asp-for="NotificationId" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />

    @if (ViewData["ModalError"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="UserId" class="form-label">User ID</label>
        <input asp-for="UserId" type="number" class="form-control" />
        <span asp-validation-for="UserId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Message" class="form-label">Message</label>
        <textarea asp-for="Message" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Message" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsRead" class="form-check-input" />
        <label asp-for="IsRead" class="form-check-label">Read</label>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save changes</button>
    </div>
</form>
