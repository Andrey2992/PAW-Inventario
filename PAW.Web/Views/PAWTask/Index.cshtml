@model IEnumerable<PAW.Models.DTO.PawTaskDTO>
@{
    ViewData["Title"] = "Task Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Tasks</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Task
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Task ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Due Date</th>
                            <th>Comments</th>
                            <th>Created Date</th>
                            <th>Modified By</th>
                            <th>Modified Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var task in Model)
                            {
                                var statusClass = (task.Status ?? string.Empty).ToLowerInvariant() switch
                                {
                                    "completed" or "done" => "bg-success",
                                    "in progress" or "inprogress" => "bg-primary",
                                    "pending" => "bg-warning text-dark",
                                    "cancelled" or "canceled" => "bg-danger",
                                    _ => "bg-secondary"
                                };

                                <tr>

                                    <td>
                                        @task.TaskId
                                    </td>

                                    <td>
                                        <strong>@task.Name</strong>
                                    </td>

                                    <td>
                                        @task.Description
                                    </td>

                                    <td>
                                        <span class="badge @statusClass">@(string.IsNullOrWhiteSpace(task.Status) ? "N/A" : task.Status)</span>
                                    </td>

                                    <td>
                                        @(task.DueDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                                    </td>

                                    <td>
                                        @task.Comments
                                    </td>

                                    <td>
                                        @task.CreatedDate.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td>
                                        @task.ModifiedBy
                                    </td>

                                    <td>
                                        @task.ModifiedDate.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@task.TaskId"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <!-- Details -->
                                            <a asp-action="Details"
                                               asp-route-id="@task.TaskId"
                                               class="btn btn-sm btn-info">
                                                Details
                                            </a>

                                            <!-- Delete -->
                                            <a asp-action="Delete"
                                               asp-route-id="@task.TaskId"
                                               class="btn btn-sm btn-danger">
                                                Delete
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center">
                                    No tasks found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>
