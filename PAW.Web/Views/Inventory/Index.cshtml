@model IEnumerable<PAW.Models.DTO.InventoryDTO>
@{
    ViewData["Title"] = "Inventory Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Inventory</h2>

        <a asp-action="Create"
           class="btn btn-primary js-modal-link"
           data-modal-title="Add inventory">
            <i class="bi bi-plus-circle"></i>
            Add Inventory
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Inventory ID</th>
                            <th>Product ID</th>
                            <th>Unit Price</th>
                            <th>Units In Stock</th>
                            <th>Comments</th>
                            <th>Date Added</th>
                            <th>Last Updated</th>
                            <th>Modified By</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var inventory in Model)
                            {
                                <tr>

                                    <td>
                                        @inventory.InventoryId
                                    </td>

                                    <td>
                                        @inventory.ProductId
                                    </td>

                                    <td>
                                        @(inventory.UnitPrice?.ToString("C2") ?? "-")
                                    </td>

                                    <td>
                                        @if (inventory.UnitsInStock is null)
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                        else if (inventory.UnitsInStock <= 0)
                                        {
                                            <span class="badge bg-danger">Out of stock</span>
                                        }
                                        else if (inventory.UnitsInStock < 10)
                                        {
                                            <span class="badge bg-warning text-dark">@inventory.UnitsInStock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@inventory.UnitsInStock</span>
                                        }
                                    </td>

                                    <td>
                                        @inventory.Comments
                                    </td>

                                    <td>
                                        @(inventory.DateAdded?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                                    </td>

                                    <td>
                                        @(inventory.LastUpdated?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                                    </td>

                                    <td>
                                        @inventory.ModifiedBy
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@inventory.InventoryId"
                                               class="btn btn-sm btn-warning js-modal-link"
                                               data-modal-title="Edit inventory">
                                                Edit
                                            </a>

                                            <!-- Details -->
                                            <a asp-action="Details"
                                               asp-route-id="@inventory.InventoryId"
                                               class="btn btn-sm btn-info js-modal-link"
                                               data-modal-title="Inventory details">
                                                Details
                                            </a>

                                            <!-- Delete -->
                                            <a asp-action="Delete"
                                               asp-route-id="@inventory.InventoryId"
                                               class="btn btn-sm btn-danger js-modal-link"
                                               data-modal-title="Delete inventory">
                                                Delete
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center">
                                    No inventory records found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

    <partial name="_Pagination" model='ViewData["Pagination"]' />

</div>
