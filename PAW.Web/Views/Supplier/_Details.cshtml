@model PAW.Web.Models.SupplierDetailsViewModel

<h6 class="border-bottom pb-1">Supplier</h6>
<partial name="_SupplierInfo" model="Model.Supplier" />
<dl class="row mt-0">
    <dt class="col-sm-4">Contact title</dt>
    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Supplier.ContactTitle) ? "Not available" : Model.Supplier.ContactTitle)</dd>

    <dt class="col-sm-4">Modified by</dt>
    <dd class="col-sm-8">@(Model.Supplier.ModifiedBy ?? "Not available")</dd>

    <dt class="col-sm-4">Last modified</dt>
    <dd class="col-sm-8">@Model.Supplier.ModifiedDate.ToString("yyyy-MM-dd HH:mm")</dd>
</dl>

<h6 class="border-bottom pb-1 mt-3">Products (@Model.Products.Count)</h6>
<partial name="_ProductAssociations" model="Model.Products" />
