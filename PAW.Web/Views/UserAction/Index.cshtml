@model IEnumerable<PAW.Models.DTO.UserActionDTO>
@{
    ViewData["Title"] = "User Action Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>User Actions</h2>

        <a asp-action="Create"
           class="btn btn-primary js-modal-link"
           data-modal-title="Add user action">
            <i class="bi bi-plus-circle"></i>
            Add User Action
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>User Action ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var userAction in Model)
                            {
                                <tr>

                                    <td>
                                        @userAction.UserActionId
                                    </td>

                                    <td>
                                        <strong>@userAction.Name</strong>
                                    </td>

                                    <td>
                                        @userAction.Description
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@userAction.UserActionId"
                                               class="btn btn-sm btn-warning js-modal-link"
                                               data-modal-title="Edit user action">
                                                Edit
                                            </a>

                                            <!-- Details -->
                                            <a asp-action="Details"
                                               asp-route-id="@userAction.UserActionId"
                                               class="btn btn-sm btn-info js-modal-link"
                                               data-modal-title="User action details">
                                                Details
                                            </a>

                                            <!-- Delete -->
                                            <a asp-action="Delete"
                                               asp-route-id="@userAction.UserActionId"
                                               class="btn btn-sm btn-danger js-modal-link"
                                               data-modal-title="Delete user action">
                                                Delete
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center">
                                    No user actions found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

    <partial name="_Pagination" model='ViewData["Pagination"]' />

</div>
